# Copy this file to .env and fill in the key(s) for the provider in config.yaml.
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Claude: uncomment and set a key, or run `ant auth login` instead. Leave the
# line commented out when unused, because an empty key can shadow other
# credentials. GitHub Actions uses Workload Identity Federation, not this key.
# ANTHROPIC_API_KEY=

# Optional override for a compatible DeepSeek endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
